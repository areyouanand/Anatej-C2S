<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/picker_settings"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/appearance"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/theme_mode"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/themeSystem"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/theme_system"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/themeLight"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/theme_light"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/themeDark"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/theme_dark"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/recognition"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ocr_script"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Spinner
            android:id="@+id/spinnerScript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/scriptNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/script_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:textColorSecondary"
            android:visibility="gone" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchBarcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/scan_barcodes" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mark_uncertain" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMagnifier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/selection_magnifier" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/feedback_settings"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHaptic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/capture_haptic" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_sound" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/trigger_settings"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHideKeyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hide_on_keyboard" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHideCalls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_on_calls" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/call_permission_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/settings_backup"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/export_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImport"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="@string/import_settings" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/clipboard_history"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHistoryEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/history_enabled" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHistoryLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/history_expiry"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Spinner
            android:id="@+id/spinnerHistoryExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/history_privacy_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/bubble_size"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="4"
            android:valueFrom="40"
            android:valueTo="96"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/bubble_opacity"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="30"
            android:valueTo="100"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/bubble_color"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/colorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/colorBlue"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/color_blue"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="2dp"
                app:backgroundTint="#3B82F6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/colorRed"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/color_red"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="2dp"
                app:backgroundTint="#EF4444" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/colorGreen"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/color_green"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="2dp"
                app:backgroundTint="#22C55E" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/colorPurple"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/color_purple"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="2dp"
                app:backgroundTint="#A855F7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/colorOrange"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/color_orange"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="2dp"
                app:backgroundTint="#F97316" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSnap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/snap_to_edge" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEdge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/corner_swipe" />

        <com.anatej.c2s.CornerPreviewView
            android:id="@+id/cornerPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/corner_selection"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/cornerGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cornerLeft"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/corner_left"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cornerRight"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/corner_right"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cornerBoth"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/corner_both"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/corner_box_width"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderCornerWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="4"
            android:valueFrom="40"
            android:valueTo="140"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/corner_box_height"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderCornerHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="4"
            android:valueFrom="100"
            android:valueTo="280"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/corner_box_inset"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderCornerInset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="4"
            android:valueFrom="0"
            android:valueTo="160"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/corner_box_lift"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderCornerLift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="4"
            android:valueFrom="0"
            android:valueTo="200"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/corner_swipe_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:textColorSecondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
